  "rulings": [
    {
      "object": "ruling",
      "oracle_id": "0895c9b7-ae7d-4bb3-af17-3b75deb50a25",
      "source": "wotc",
      "published_at": "2020-11-10",
      "comment": "If you have two commanders, the ability adds one mana of any color in their combined color identities."
    },
    {
      "object": "ruling",
      "oracle_id": "0895c9b7-ae7d-4bb3-af17-3b75deb50a25",
      "source": "wotc",
      "published_at": "2020-11-10",
      "comment": "If your commander is a card that has no colors in its color identity, Command Tower's ability produces no mana. It doesn't produce {C}."
    },
    {
      "object": "ruling",
      "oracle_id": "0895c9b7-ae7d-4bb3-af17-3b75deb50a25",
      "source": "wotc",
      "published_at": "2020-11-10",
      "comment": "If you don't have a commander, Command Tower's ability produces no mana."
    },
    {
      "object": "ruling",
      "oracle_id": "0bc7f093-bef0-4f1a-852c-4b75ebf54838",
      "source": "wotc",
      "published_at": "2020-11-10",
      "comment": "If you have two commanders, the ability adds one mana of any color in their combined color identities."
    },
    {
      "object": "ruling",
      "oracle_id": "0bc7f093-bef0-4f1a-852c-4b75ebf54838",
      "source": "wotc",
      "published_at": "2020-11-10",
      "comment": "If your commander is a card that has no colors in its color identity, Arcane Signet's ability produces no mana. It doesn't produce {C}."
    },
    {
      "object": "ruling",
      "oracle_id": "0bc7f093-bef0-4f1a-852c-4b75ebf54838",
      "source": "wotc",
      "published_at": "2020-11-10",
      "comment": "If you don't have a commander, Arcane Signet's ability produces no mana."
    },
    {
      "object": "ruling",
      "oracle_id": "a3ce0fa9-8742-4e2c-a8a0-00fc009f998a",
      "source": "wotc",
      "published_at": "2023-11-10",
      "comment": "A \"Dinosaur source\" is any object with the creature type Dinosaur. This means you could spend the mana to activate an ability of a Dinosaur you control or a Dinosaur card in your hand or graveyard, for example."
    },
    {
      "object": "ruling",
      "oracle_id": "a4e5693f-12a0-451e-818d-d6efc7b4ed25",
      "source": "wotc",
      "published_at": "2022-12-08",
      "comment": "You must choose a legal target for each target required by Decimate. However, if a permanent has multiple card types, it may be chosen as the target for more than one instance of the word \"target.\" For example, you could cast Decimate targeting an artifact creature, an enchantment, and a land."
    },
    {
      "object": "ruling",
      "oracle_id": "b1544f21-7e98-461b-aed5-e748b0168c52",
      "source": "wotc",
      "published_at": "2022-12-08",
      "comment": "Use the power of the creature from when it was last on the battlefield to determine how much life is gained."
    },
    {
      "object": "ruling",
      "oracle_id": "f61680da-606e-4d16-b0a0-361aa5210901",
      "source": "wotc",
      "published_at": "2015-06-22",
      "comment": "If the creature becomes an illegal target by the time Chandra's Ignition tries to resolve (perhaps because another player controls it or it's left the battlefield), Chandra's Ignition won't resolve and none of its effects will happen. No damage will be dealt."
    },
    {
      "object": "ruling",
      "oracle_id": "f61680da-606e-4d16-b0a0-361aa5210901",
      "source": "wotc",
      "published_at": "2015-06-22",
      "comment": "Use the power of the target creature as Chandra's Ignition resolves to determine how much damage it deals to each other creature and each opponent."
    },
    {
      "object": "ruling",
      "oracle_id": "f61680da-606e-4d16-b0a0-361aa5210901",
      "source": "wotc",
      "published_at": "2015-06-22",
      "comment": "The creature is the source of the damage, not Chandra's Ignition. For example, Chandra's Ignition can have a white creature deal damage to a creature with protection from red."
    }
  ]
